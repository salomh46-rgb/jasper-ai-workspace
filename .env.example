# ===================================================
# Jasper AI Workspace - Railway Production Environment
# ===================================================

# Environment
ENVIRONMENT=production
PROJECT_NAME="Jasper AI Workspace"
SECRET_KEY=jasper-super-secret-workspace-key-2026-antigravity
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Database (PostgreSQL on Railway or SQLite fallback)
DATABASE_URL=sqlite+aiosqlite:///./jasper_workspace.db

# Google Gemini AI API Key (Required for AI Agents & Voice)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-flash-lite-latest

# Telegram Master Bot (Required for Mini App & Owner Alerts)
MASTER_BOT_TOKEN=YOUR_TELEGRAM_MASTER_BOT_TOKEN_HERE

# Production Webhook/Base URL (Your Railway provided HTTPS URL, e.g. https://jasper-workspace.up.railway.app)
WEBHOOK_BASE_URL=https://YOUR_APP_NAME.up.railway.app
